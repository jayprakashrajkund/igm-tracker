rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner() {
      return request.auth != null
        && request.auth.token.email == 'jayprakashrajkund@gmail.com'
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }
    match /activities/{document} {
      allow read, write: if isOwner();
    }
    match /accounts/{accountId} {
      allow read, create, update: if isOwner();
    }
    match /directoryImports/{importId} {
      allow read, create: if isOwner();
    }
    match /activityLinks/{activityId} {
      allow read, create, update: if isOwner();
    }
    // Preserve the legacy collections without permitting changes from the app.
    match /igm_entries/{document} {
      allow read: if isOwner();
    }
    match /igm_custom_clients/{document} {
      allow read: if isOwner();
    }
  }
}
